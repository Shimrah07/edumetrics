# =============================================
# EduMetrics — Root .gitignore
# =============================================

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
*.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/.vite/
.pnpm-store/
.npm/
*.tgz

# ---- Build outputs ----
dist/
build/
out/
*.min.js.map

# ---- ML artifacts ----
/models/
*.pkl
*.joblib
*.h5
*.onnx

# ---- Uploaded datasets ----
uploads/
datasets/
*.csv
*.xlsx
*.xls

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- OS & IDE ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Alembic ----
# (keep alembic/versions/ tracked — only ignore local test dbs)

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Temporary ----
tmp/
temp/
.cache/
